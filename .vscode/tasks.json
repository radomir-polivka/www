{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload current file",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\upload-file.ps1",
        "${file}"
      ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
